# Dependencies
node_modules/

# Environment variables — NEVER commit these
.env
.env.local
.env.*.local

# Build output
dist/
dist-ssr/

# Logs
*.log
npm-debug.log*

# Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# OS
.DS_Store
Thumbs.db

# Supabase local dev
supabase/.branches
supabase/.temp

# TypeScript incremental build cache
*.tsbuildinfo

# Claude Code — état local (sessions, verrous, worktrees imbriqués, chemins
# spécifiques à la machine) ; launch.json reste versionné (partagé entre
# contributeurs, voir CLAUDE.md §Test navigateur automatisé)
.claude/*
!.claude/launch.json

# Fichiers de vérification temporaires (scratch de session, non versionnés)
.tmp-verif/

# Dumps de données participants (RGPD) — sauvegardes avant migration
entry_responses_backup_*.sql
